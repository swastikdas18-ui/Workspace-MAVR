{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Web Request Lifecycle: Cache Miss & PostgreSQL Fallback",
    "subtitle": "Browser API invocation with Redis cache check, database fallback, and cache population",
    "output": "docs/diagrams/web-request-cache-miss.html",
    "viewBox": [1000, 600],
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "browser",
      "type": "frontend",
      "label": "Browser",
      "sublabel": "client application"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "API Server",
      "sublabel": "Hono / Node.js"
    },
    {
      "id": "redis",
      "type": "database",
      "label": "Redis",
      "sublabel": "cache layer"
    },
    {
      "id": "postgres",
      "type": "database",
      "label": "PostgreSQL",
      "sublabel": "persistent store"
    }
  ],
  "segments": [
    { "from": 160, "to": 260, "label": "1. Request & Cache Check" },
    { "from": 270, "to": 390, "label": "2. Cache Miss & Database Query" },
    { "from": 400, "to": 500, "label": "3. Cache Population & Client Response" }
  ],
  "messages": [
    {
      "id": "msg-api-request",
      "from": "browser",
      "to": "api",
      "y": 175,
      "label": "GET /api/data",
      "variant": "emphasis"
    },
    {
      "id": "msg-redis-check",
      "from": "api",
      "to": "redis",
      "y": 210,
      "label": "GET cache:key",
      "variant": "default"
    },
    {
      "id": "msg-redis-miss",
      "from": "redis",
      "to": "api",
      "y": 245,
      "label": "(nil) cache miss",
      "variant": "return"
    },
    {
      "id": "msg-pg-query",
      "from": "api",
      "to": "postgres",
      "y": 295,
      "label": "SELECT * FROM data WHERE id = ?",
      "variant": "emphasis"
    },
    {
      "id": "msg-pg-result",
      "from": "postgres",
      "to": "api",
      "y": 345,
      "label": "Row result payload",
      "variant": "return"
    },
    {
      "id": "msg-redis-set",
      "from": "api",
      "to": "redis",
      "y": 415,
      "label": "SETEX cache:key 3600 data",
      "variant": "dashed"
    },
    {
      "id": "msg-redis-ack",
      "from": "redis",
      "to": "api",
      "y": 445,
      "label": "OK (cached)",
      "variant": "return"
    },
    {
      "id": "msg-client-response",
      "from": "api",
      "to": "browser",
      "y": 480,
      "label": "200 OK (JSON response)",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "browser",
      "from": 175,
      "to": 485,
      "type": "frontend"
    },
    {
      "participant": "api",
      "from": 175,
      "to": 480,
      "type": "backend"
    },
    {
      "participant": "redis",
      "from": 210,
      "to": 250,
      "type": "database"
    },
    {
      "participant": "postgres",
      "from": 295,
      "to": 350,
      "type": "database"
    },
    {
      "participant": "redis",
      "from": 415,
      "to": 450,
      "type": "database"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Client Request",
      "items": [
        "The Browser issues an HTTP request to the API server",
        "The API handler coordinates authentication and cache inspection"
      ]
    },
    {
      "dot": "amber",
      "title": "Cache-Aside Pattern",
      "items": [
        "API performs a non-blocking lookup in Redis",
        "On cache miss ((nil)), the request falls back to PostgreSQL",
        "Primary database query executes with referential indexing"
      ]
    },
    {
      "dot": "cyan",
      "title": "Fill & Respond",
      "items": [
        "Database row result is read by the API server",
        "Redis cache is populated with TTL via SETEX",
        "Client receives 200 OK payload"
      ]
    }
  ]
}
