# ==============================================================================
# Workspace OS — Environment Configuration Template
# Copy this file to .env for local development.
# In production / Cloud Run, inject these via Environment Variables / Secrets.
# ==============================================================================

# Server Environment & Port (Cloud Run dynamically injects PORT)
NODE_ENV=production
PORT=3000

# PostgreSQL Database Connection (Neon Serverless or standard PostgreSQL)
# Example: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=

# Better Auth & Session Security
# 32+ character random hex or base64 string used to sign sessions
BETTER_AUTH_SECRET=

# Public Base URL of the Application & Authentication Service
BETTER_AUTH_URL=https://workspace-mavr.onrender.com
APP_URL=https://workspace-mavr.onrender.com
FRONTEND_URL=https://workspace-mavr.vercel.app

# Frontend Client API Target (for Vercel Frontend connecting to Render Backend)
VITE_API_URL=https://workspace-mavr.onrender.com

# Demo Mode (Set to false in production to strictly disable demo logins/bypasses)
DEMO_MODE=false

# Optional Gemini AI API Integration
GEMINI_API_KEY=

# Backblaze B2 S3-Compatible Object Storage
B2_KEY_ID=005f99404980e080000000001
B2_APPLICATION_KEY=
B2_BUCKET_NAME=workspace-os-vault
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_PUBLIC_URL=https://f005.backblazeb2.com/file/workspace-os-vault

